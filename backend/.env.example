# Flask
SECRET_KEY=change-me
FLASK_DEBUG=0

# 数据库。留空则使用 backend/instance/study_assistant.db
# 切换 MySQL / PostgreSQL 时改这里即可，例如：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/study_assistant?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/study_assistant
# DATABASE_URL=

# 上传文件目录。留空则使用 backend/uploads
# UPLOAD_FOLDER=

# 单次上传大小上限（字节），默认 50MB
MAX_CONTENT_LENGTH=52428800

# 大模型：OpenAI 兼容的 Chat Completions 接口
# 访问地址与 API Key 分开配置，可直接指向自建网关或第三方兼容服务
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
# 直接提供所选资料时的字符数上限（超限时后续接口须明确提示，不静默截断）
LLM_MAX_CONTEXT_CHARS=24000

# 身份体系接入前，所有数据归属该开发用户
DEV_USER_ID=dev-user
DEFAULT_TIMEZONE=Asia/Shanghai
